<Window x:Class="SoundPair.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Pair - Tri-Device Audio Streamer" 
        Icon="SoundPair.ico"
        MinWidth="480" MinHeight="520"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Windows 11 Dark Mode Color Palette -->
        <SolidColorBrush x:Key="CardBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#404040"/>
        <SolidColorBrush x:Key="TextSec" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="Highlight" Color="#60CDFF"/>
        <SolidColorBrush x:Key="DarkInputBg" Color="#333333"/>
        <SolidColorBrush x:Key="DarkInputBorder" Color="#454545"/>

        <!-- Generic Text Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- True Dark Mode ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource DarkInputBg}" BorderBrush="{StaticResource DarkInputBorder}" BorderThickness="1" CornerRadius="4">
                                            <Path x:Name="Arrow" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{StaticResource CardBg}" BorderThickness="1" BorderBrush="{StaticResource CardBorder}" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="150" Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="9,5"/>
                        <Setter Property="Margin" Value="3,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Button Style -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" x:Name="colMain"/>
            <ColumnDefinition Width="Auto" x:Name="colSide"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12">
                
                <!-- Header -->
                <Border CornerRadius="8" Margin="0,0,0,10" Padding="14,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#5A47C1" Offset="0"/>
                            <GradientStop Color="#B2356B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Sound Pair (Tri Mode)" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Stream system audio to up to 3 outputs with visual latency calibration" FontSize="12" Foreground="#E0E0E0" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

            <!-- Card 1: Devices & Calibration -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Slot 1 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Slot 1:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                        <ComboBox x:Name="comboDevice1" Grid.Column="1" Height="30"/>
                        <Button x:Name="btnCalDevice1" Grid.Column="3" Content="🎯 Cal" Height="30" 
                                Background="#383838" BorderBrush="#4A4A4A" BorderThickness="1"
                                Click="BtnCalDevice1_Click" Style="{StaticResource DarkButton}" FontSize="12"
                                ToolTip="Calibrate latency for Device Slot 1"/>
                    </Grid>

                    <!-- Slot 2 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Slot 2:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                        <ComboBox x:Name="comboDevice2" Grid.Column="1" Height="30"/>
                        <Button x:Name="btnCalDevice2" Grid.Column="3" Content="🎯 Cal" Height="30" 
                                Background="#383838" BorderBrush="#4A4A4A" BorderThickness="1"
                                Click="BtnCalDevice2_Click" Style="{StaticResource DarkButton}" FontSize="12"
                                ToolTip="Calibrate latency for Device Slot 2"/>
                    </Grid>

                    <!-- Slot 3 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Slot 3:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                        <ComboBox x:Name="comboDevice3" Grid.Column="1" Height="30"/>
                        <Button x:Name="btnCalDevice3" Grid.Column="3" Content="🎯 Cal" Height="30" 
                                Background="#383838" BorderBrush="#4A4A4A" BorderThickness="1"
                                Click="BtnCalDevice3_Click" Style="{StaticResource DarkButton}" FontSize="12"
                                ToolTip="Calibrate latency for Device Slot 3"/>
                    </Grid>

                    <!-- Master Global Calibration Button -->
                    <Button x:Name="btnGlobalCalibrate" Content="🌐 Global Calibration (All Devices Sync)" Height="36" 
                            Background="#243447" Foreground="{StaticResource Highlight}" BorderBrush="#354E6B" BorderThickness="1"
                            Click="BtnGlobalCalibrate_Click" Style="{StaticResource DarkButton}" FontSize="12.5"
                            ToolTip="Calibrate visual &amp; audio latency for all active outputs together"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Output Volumes -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Output Volumes" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                    <!-- Device 1 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vol 1:" Foreground="{StaticResource TextSec}" FontSize="12.5" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="sliderVol1" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="SliderVol_ValueChanged"/>
                        <TextBlock Grid.Column="3" x:Name="lblVol1Val" Text="100%" Foreground="{StaticResource Highlight}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Device 2 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vol 2:" Foreground="{StaticResource TextSec}" FontSize="12.5" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="sliderVol2" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="SliderVol_ValueChanged"/>
                        <TextBlock Grid.Column="3" x:Name="lblVol2Val" Text="100%" Foreground="{StaticResource Highlight}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Device 3 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vol 3:" Foreground="{StaticResource TextSec}" FontSize="12.5" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="sliderVol3" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="SliderVol_ValueChanged"/>
                        <TextBlock Grid.Column="3" x:Name="lblVol3Val" Text="100%" Foreground="{StaticResource Highlight}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Stream Control & Media Sync (Merged Delay Display & Actions) -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <!-- Media Player Lip-Sync Offset Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎬 Media Lip-Sync Offset:" Foreground="{StaticResource TextSec}" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblGlobalOffset" Text="0 ms" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Highlight}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="• VLC: 'J' / 'K'  • PotPlayer: 'Shift + &gt;' / '&lt;'  • MPC-HC: Shift" 
                                       Foreground="#808080" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnCopyOffset" Grid.Column="1" Content="Copy Offset" Height="28" Padding="12,0" 
                                Background="#383838" Foreground="#FFFFFF" BorderBrush="#4A4A4A" BorderThickness="1"
                                Style="{StaticResource DarkButton}" Click="BtnCopyOffset_Click" VerticalAlignment="Center"
                                FontSize="12" ToolTip="Copy delay offset for media player sync (VLC, PotPlayer, MPC-HC)"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#383838" Margin="0,4,0,10"/>

                    <!-- Stream Action Buttons -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" x:Name="btnStart" Content="Start Streaming" Height="36" 
                                BorderThickness="1" BorderBrush="#3A4354" 
                                Background="{StaticResource Highlight}" Foreground="Black"
                                Click="BtnStart_Click" Style="{StaticResource DarkButton}" FontSize="13"/>
                        
                        <Button Grid.Column="2" x:Name="btnStop" Content="Stop" Height="36" 
                                Background="#333333" Foreground="#FFFFFF" BorderThickness="1" 
                                BorderBrush="#454545" IsEnabled="False" Click="BtnStop_Click" 
                                Style="{StaticResource DarkButton}" FontSize="13"/>
                    </Grid>
                    
                    <!-- Status Text -->
                    <TextBlock x:Name="lblStatus" Text="Status: Ready" Foreground="{StaticResource TextSec}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- Right Side Panel: Visual Calibration Studio -->
    <Border Grid.Column="1" x:Name="borderSidePanel" Visibility="Collapsed"
            Background="#1B1B1B" BorderBrush="#353535" BorderThickness="1,0,0,0" Width="450">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,8">
                
                <!-- Header with Close button -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🎯 Calibration Studio" FontSize="14" FontWeight="SemiBold" Foreground="#60CDFF"/>
                        <TextBlock Text="Visual audio &amp; video latency sync" FontSize="11" Foreground="{StaticResource TextSec}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="btnCloseSidePanel" Content="✕" Width="24" Height="24"
                            Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#3C3C3C" BorderThickness="1"
                            Click="BtnCloseSidePanel_Click" Style="{StaticResource DarkButton}" FontSize="11.5"
                            ToolTip="Close Side Panel"/>
                </Grid>

                <!-- Slot Selection Tabs (Global + 3 Slots) -->
                <Border Background="#252525" CornerRadius="5" BorderBrush="#383838" BorderThickness="1" Padding="2" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnTabGlobal" Content="🌐 Global" Height="26" Click="BtnTabSlot_Click" Margin="1" Style="{StaticResource DarkButton}" Background="#243447" Foreground="#60CDFF" FontSize="11.5"/>
                        <Button Grid.Column="1" x:Name="btnTabSlot1" Content="Slot 1" Height="26" Click="BtnTabSlot_Click" Margin="1" Style="{StaticResource DarkButton}" Background="#2E2E2E" Foreground="#AAAAAA" FontSize="11.5"/>
                        <Button Grid.Column="2" x:Name="btnTabSlot2" Content="Slot 2" Height="26" Click="BtnTabSlot_Click" Margin="1" Style="{StaticResource DarkButton}" Background="#2E2E2E" Foreground="#AAAAAA" FontSize="11.5"/>
                        <Button Grid.Column="3" x:Name="btnTabSlot3" Content="Slot 3" Height="26" Click="BtnTabSlot_Click" Margin="1" Style="{StaticResource DarkButton}" Background="#2E2E2E" Foreground="#AAAAAA" FontSize="11.5"/>
                    </Grid>
                </Border>

                <!-- Active Calibrating Device Label (Compact Single Row) -->
                <Border Background="#232323" CornerRadius="5" Padding="8,4" Margin="0,0,0,5" BorderBrush="#333333" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="lblCalModeHeader" Text="Target: " FontSize="11" Foreground="{StaticResource TextSec}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="lblCalActiveDevice" Text="[None Selected]" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Ball Drop Canvas Stage (Compact 135px Height) -->
                <Border Background="#141414" CornerRadius="6" BorderBrush="#2E2E2E" BorderThickness="1" Height="135" Margin="0,0,0,5" ClipToBounds="True">
                    <Grid>
                        <!-- Vertical drop chute background -->
                        <Canvas x:Name="canvasDropStage" Width="420" Height="135">
                            <!-- Chute rail guide centered at X=210 -->
                            <Rectangle Canvas.Left="192" Canvas.Top="6" Width="36" Height="104" RadiusX="6" RadiusY="6" Fill="#1E1E1E" Stroke="#2D2D2D" StrokeThickness="1"/>
                            <Line Canvas.Left="210" X1="0" Y1="10" X2="0" Y2="110" Stroke="#363636" StrokeDashArray="3 3" StrokeThickness="1.5"/>

                            <!-- Target Line & Markers -->
                            <Rectangle Canvas.Left="155" Canvas.Top="110" Width="110" Height="3" Fill="#60CDFF" RadiusX="1.5" RadiusY="1.5"/>
                            <!-- Target indicator labels -->
                            <TextBlock Canvas.Left="108" Canvas.Top="105" Text="TARGET" FontSize="9" FontWeight="Bold" Foreground="#60CDFF"/>
                            <TextBlock Canvas.Left="275" Canvas.Top="105" Text="TARGET" FontSize="9" FontWeight="Bold" Foreground="#60CDFF"/>

                            <!-- Impact Ripple (expands when ball hits at 210, 110) -->
                            <Ellipse x:Name="rippleRing" Canvas.Left="210" Canvas.Top="110" Width="0" Height="0" 
                                     Stroke="#60CDFF" StrokeThickness="2" Opacity="0" IsHitTestVisible="False"/>

                            <!-- The Dropping Ball -->
                            <Ellipse x:Name="ballElement" Canvas.Left="199" Canvas.Top="8" Width="22" Height="22" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35" RadiusX="0.65" RadiusY="0.65">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#60CDFF" Offset="0.45"/>
                                        <GradientStop Color="#0066CC" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#60CDFF" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>

                        <!-- Countdown / Action Overlay Banner -->
                        <Border x:Name="borderStagePrompt" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0" 
                                Background="#E0222222" CornerRadius="4" Padding="10,3" BorderBrush="#404040" BorderThickness="1">
                            <TextBlock x:Name="lblStagePrompt" Text="Click 'Start Drop' or press [Spacebar] to calibrate!" FontSize="11" Foreground="#E0E0E0" TextAlignment="Center"/>
                        </Border>

                        <!-- Big Center Feedback on Spacebar press -->
                        <Border x:Name="borderFeedback" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Background="#E6102538" CornerRadius="5" Padding="14,5" BorderBrush="#60CDFF" BorderThickness="1.5" Visibility="Collapsed">
                            <TextBlock x:Name="lblFeedbackText" Text="Tap: 185 ms" FontSize="14" FontWeight="Bold" Foreground="#60CDFF" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tap Recording Indicator / Stats (Compact Row) -->
                <Border Background="#252525" CornerRadius="5" BorderBrush="#353535" BorderThickness="1" Padding="10,5" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Recorded Samples (Taps):" FontSize="10" Foreground="{StaticResource TextSec}"/>
                            <TextBlock x:Name="lblTapHistory" Text="Press [Spacebar] when sound plays" FontSize="11.5" Foreground="#FFFFFF" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Measured Latency:" FontSize="10" Foreground="{StaticResource TextSec}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="lblAvgLatency" Text="-- ms" FontSize="15" FontWeight="Bold" Foreground="#60CDFF" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fine-Tuning & Human Reaction Compensation (Compact) -->
                <Border x:Name="borderReactionTuneCard" Background="#222222" CornerRadius="5" BorderBrush="#303030" BorderThickness="1" Padding="8,5" Margin="0,0,0,5">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chkHumanReaction" Content="Compensate Reaction Time (-200ms)" Foreground="#D0D0D0" FontSize="11" IsChecked="True" VerticalAlignment="Center" Checked="ChkHumanReaction_Changed" Unchecked="ChkHumanReaction_Changed" ToolTip="Subtracts average human auditory reaction time (~200ms) to estimate the physical device latency"/>
                            <Button x:Name="btnResetTaps" Grid.Column="1" Content="↺ Reset" Height="20" Padding="6,0" Background="#333333" BorderBrush="#454545" BorderThickness="1" Style="{StaticResource DarkButton}" FontSize="10.5" Click="BtnResetTaps_Click"/>
                        </Grid>

                        <!-- Manual Nudge / Stepper -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fine-Tune Latency:" Foreground="{StaticResource TextSec}" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="- 5 ms" Height="22" Padding="6,0" Margin="3,0" Background="#333333" BorderBrush="#454545" BorderThickness="1" Style="{StaticResource DarkButton}" FontSize="10.5" Click="BtnNudgeDown_Click"/>
                            <TextBlock Grid.Column="2" x:Name="lblFineTuneVal" Text="0 ms" Foreground="#60CDFF" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="3,0" MinWidth="42" TextAlignment="Center"/>
                            <Button Grid.Column="3" Content="+ 5 ms" Height="22" Padding="6,0" Margin="3,0" Background="#333333" BorderBrush="#454545" BorderThickness="1" Style="{StaticResource DarkButton}" FontSize="10.5" Click="BtnNudgeUp_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Controls: Start Drop / Apply / Clear in One Compact Row -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" x:Name="btnTriggerDrop" Content="▶ Start Drop" Height="30" 
                            Background="#243447" Foreground="{StaticResource Highlight}" BorderBrush="#354E6B" BorderThickness="1"
                            Click="BtnTriggerDrop_Click" Style="{StaticResource DarkButton}" FontSize="12"/>

                    <Button Grid.Column="2" x:Name="btnApplyCal" Content="💾 Apply" Height="30" 
                            Background="#2E4A35" Foreground="#70FFA0" BorderBrush="#3D6846" BorderThickness="1"
                            Click="BtnApplyCal_Click" Style="{StaticResource DarkButton}" FontSize="12"/>

                    <Button Grid.Column="4" x:Name="btnClearSaved" Content="🗑️ Clear" Height="30"
                            Background="#2B2424" Foreground="#FF9999" BorderBrush="#4D3535" BorderThickness="1"
                            Click="BtnClearSaved_Click" Style="{StaticResource DarkButton}" FontSize="11.5"
                            ToolTip="Clear saved calibration profile for this slot and reset delay to 0 ms"/>
                </Grid>

                <!-- Hardware Delay Offset Card (Individual Slot Only - Ultra-Compact) -->
                <Border x:Name="borderSlotDelayCard" Background="#252525" CornerRadius="5" BorderBrush="#383838" BorderThickness="1" Padding="8,5" Margin="0,0,0,2" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblDelayCardHeader" Text="⏱ Slot Delay Offset" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="Click ms to reset to 0" FontSize="10" Foreground="{StaticResource TextSec}" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Delay Slot 1 -->
                        <Grid x:Name="gridDelaySlot1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Delay 1:" Foreground="{StaticResource TextSec}" FontSize="11.5" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sliderDelay1" Minimum="0" Maximum="300" Value="0" VerticalAlignment="Center" ValueChanged="SliderDelay_ValueChanged"/>
                            <TextBlock Grid.Column="3" x:Name="lblDelay1Val" Text="0 ms" Foreground="{StaticResource Highlight}" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to reset to 0" MouseLeftButtonDown="LblDelay_Reset_Click"/>
                        </Grid>

                        <!-- Delay Slot 2 -->
                        <Grid x:Name="gridDelaySlot2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Delay 2:" Foreground="{StaticResource TextSec}" FontSize="11.5" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sliderDelay2" Minimum="0" Maximum="300" Value="0" VerticalAlignment="Center" ValueChanged="SliderDelay_ValueChanged"/>
                            <TextBlock Grid.Column="3" x:Name="lblDelay2Val" Text="0 ms" Foreground="{StaticResource Highlight}" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to reset to 0" MouseLeftButtonDown="LblDelay_Reset_Click"/>
                        </Grid>

                        <!-- Delay Slot 3 -->
                        <Grid x:Name="gridDelaySlot3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Delay 3:" Foreground="{StaticResource TextSec}" FontSize="11.5" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sliderDelay3" Minimum="0" Maximum="300" Value="0" VerticalAlignment="Center" ValueChanged="SliderDelay_ValueChanged"/>
                            <TextBlock Grid.Column="3" x:Name="lblDelay3Val" Text="0 ms" Foreground="{StaticResource Highlight}" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to reset to 0" MouseLeftButtonDown="LblDelay_Reset_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Grid>
</Window>