<Window x:Class="SoundPair.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Pair - Tri-Device Audio Streamer" 
        SizeToContent="Height" Width="420" 
        WindowStartupLocation="CenterScreen"
        Background="#12161F"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="CardBg" Color="#1A202C"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2D3748"/>
        <SolidColorBrush x:Key="TextSec" Color="#828CA0"/>
        <SolidColorBrush x:Key="Highlight" Color="#50AAFF"/>
        <SolidColorBrush x:Key="DarkInputBg" Color="#232B3A"/>
        <SolidColorBrush x:Key="DarkInputBorder" Color="#3E4C63"/>

        <!-- Generic Text Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- True Dark Mode ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource DarkInputBg}" BorderBrush="{StaticResource DarkInputBorder}" BorderThickness="1" CornerRadius="4">
                                            <Path x:Name="Arrow" Fill="#F0F4F8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,30,0" VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{StaticResource DarkInputBg}" BorderThickness="1" BorderBrush="{StaticResource DarkInputBorder}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="150">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F0F4F8"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#313D52"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Button Style -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="15">
        
        <!-- Header -->
        <Border CornerRadius="10" Margin="0,0,0,15" Padding="15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#735FE6" Offset="0"/>
                    <GradientStop Color="#DC4B8C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Sound Pair (Tri Mode)" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Stream system audio to up to 3 flexible outputs" FontSize="13" Foreground="#E6E6FA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card 1: Devices -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Device Slot 1 (Primary):" Foreground="{StaticResource TextSec}"/>
                <ComboBox x:Name="comboDevice1"/>

                <TextBlock Text="Device Slot 2 (Optional / Adjustable):" Foreground="{StaticResource TextSec}"/>
                <ComboBox x:Name="comboDevice2"/>

                <TextBlock Text="Device Slot 3 (Optional / Adjustable):" Foreground="{StaticResource TextSec}"/>
                <ComboBox x:Name="comboDevice3" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card 2: Controls -->
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Vol 1:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center"/>
                <Slider Grid.Row="0" Grid.Column="1" x:Name="sliderVol1" Maximum="100" Value="100" Margin="10,8" ValueChanged="SliderVol_ValueChanged"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblVol1Val" Text="100%" Foreground="{StaticResource Highlight}" TextAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vol 2:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="sliderVol2" Maximum="100" Value="100" Margin="10,8" ValueChanged="SliderVol_ValueChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lblVol2Val" Text="100%" Foreground="{StaticResource Highlight}" TextAlignment="Right" VerticalAlignment="Center"/>

                <!-- Delay 2: Centered at 0, spans -200 to +200 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delay 2:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center"/>
                <Slider Grid.Row="2" Grid.Column="1" x:Name="sliderDelay2" Minimum="-200" Maximum="200" Value="0" Margin="10,8" ValueChanged="SliderDelay_ValueChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lblDelay2Val" Text="0 ms" Foreground="{StaticResource Highlight}" TextAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vol 3:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center"/>
                <Slider Grid.Row="3" Grid.Column="1" x:Name="sliderVol3" Maximum="100" Value="100" Margin="10,8" ValueChanged="SliderVol_ValueChanged"/>
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="lblVol3Val" Text="100%" Foreground="{StaticResource Highlight}" TextAlignment="Right" VerticalAlignment="Center"/>

                <!-- Delay 3: Centered at 0, spans -200 to +200 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Delay 3:" Foreground="{StaticResource TextSec}" VerticalAlignment="Center"/>
                <Slider Grid.Row="4" Grid.Column="1" x:Name="sliderDelay3" Minimum="-200" Maximum="200" Value="0" Margin="10,8" ValueChanged="SliderDelay_ValueChanged"/>
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="lblDelay3Val" Text="0 ms" Foreground="{StaticResource Highlight}" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Card 3: Actions -->
        <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" x:Name="btnStart" Content="Start Streaming" Height="40" BorderThickness="0" Click="BtnStart_Click" Style="{StaticResource DarkButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#735FE6" Offset="0"/>
                                <GradientStop Color="#DC4B8C" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    
                    <Button Grid.Column="2" x:Name="btnStop" Content="Stop" Height="40" Background="#283040" Foreground="#6E788C" BorderThickness="0" IsEnabled="False" Click="BtnStop_Click" Style="{StaticResource DarkButton}"/>
                </Grid>
                
                <TextBlock x:Name="lblStatus" Text="Status: Ready" Foreground="{StaticResource TextSec}" FontSize="12"/>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>